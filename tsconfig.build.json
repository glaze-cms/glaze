{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"moduleResolution": "bundler",

		"declaration": true,
		"emitDeclarationOnly": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"baseUrl": ".",
		"paths": {
			"@glaze/core": ["./packages/core/index.ts"],
			"@glaze/logger": ["./packages/logger/index.ts"]
		}
	}
}
