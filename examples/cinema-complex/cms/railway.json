{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "bun run build",
		"buildEnvironment": "V3",
		"nixpacksPlan": {
			"phases": {
				"install": {
					"includedFiles": ["bunfig.toml"]
				}
			}
		}
	},
	"deploy": {
		"runtime": "V2",
		"numReplicas": 1,
		"startCommand": "bun run start",
		"limitOverride": {
			"containers": {
				"cpu": 2,
				"memoryBytes": 4000000000
			}
		},
		"overlapSeconds": 0,
		"drainingSeconds": 0,
		"sleepApplication": true,
		"useLegacyStacker": false,
		"multiRegionConfig": {
			"us-east4-eqdc4a": {
				"numReplicas": 1
			}
		},
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 10
	}
}
