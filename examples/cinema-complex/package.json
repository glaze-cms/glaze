{
	"name": "glaze-cms",
	"private": true,
	"description": "A fictional cinema complex management system to showcase Bun CMS feataures and capabilities.",
	"scripts": {
		"dev": "bun --elide-lines 0 --filter './web' --filter './cms' dev",
		"test": "bun test",
		"lint": "bun --filter '*' lint",
		"lint:fix": "bun --filter '*' lint --fix",
		"format": "bun run --filter '*' format",
		"format:fix": "bun run --filter '*' format:fix",
		"typecheck": "bun --filter '*' typecheck",
		"clean": "rm -rf node_modules packages/*/node_modules bun.lock"
	},
	"workspaces": [
		"web",
		"cms"
	]
}
