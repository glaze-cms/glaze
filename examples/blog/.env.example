# A long random secret used to sign auth sessions. Required in production; a dev fallback is used when unset.
GLAZE_AUTH_SECRET=replace-with-a-long-random-secret

# Optional. The first admin is made by signing up and then claiming admin at
# `POST /api/setup/first-admin`, which works only until an admin exists. Set this if strangers can
# reach the server before you have done that; the claim then also needs it in the
# `x-glaze-setup-token` header. Random, at least 16 characters:  openssl rand -hex 16
# GLAZE_SETUP_TOKEN=

# The port the server listens on (optional; defaults to 4000).
# GLAZE_PORT=4000

# Local dev: serve the admin from the Vite dev server (HMR, no build). Run `bun run dev` in
# packages/glaze-admin alongside this server. `true` uses the default Vite origin (http://localhost:5173);
# set a full URL instead to override the port. Remove/unset in production, where the built admin is served.
GLAZE_ADMIN_DEV_URL=true
