{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"ignorePatterns": ["packages/glaze-admin/gen"],
	"sortImports": {
		"newlinesBetween": true,
		"groups": [
			"value-builtin",
			"value-external",
			"value-internal",
			["value-parent", "value-sibling", "value-index"],
			"type-import",
			"unknown"
		]
	}
}
