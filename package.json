{
	"name": "glaze",
	"private": true,
	"description": "Glaze CMS monorepo — the Bun-native headless CMS framework.",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"type": "module",
	"scripts": {
		"typecheck": "bun --filter '*' typecheck",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"test": "bun test packages/glaze-cms",
		"test:admin": "cd packages/glaze-admin && bun test",
		"test:node": "node --test \"packages/glaze-cms/**/*.test.ts\""
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxfmt": "latest",
		"oxlint": "latest",
		"oxlint-tsgolint": "^0.25.0",
		"typescript": "latest"
	}
}
