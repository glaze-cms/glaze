{
	"name": "glaze-cms",
	"private": true,
	"description": "Glaze CMS - A Bun native CMS",
	"scripts": {
		"dev": "bun --elide-lines 0 --filter '*' dev",
		"dev:docker": "bun --filter '*' dev",
		"dev:docker:up": "bun scripts/docker-dev.ts",
		"test": "bun test",
		"lint": "bun --filter '*' lint",
		"lint:fix": "bun --filter '*' lint --fix",
		"format": "bun run --filter '*' format",
		"format:fix": "bun run --filter '*' format:fix",
		"typecheck": "bun --filter '*' typecheck",
		"clean": "rm -rf node_modules packages/*/node_modules bun.lock",
		"pre-release": "bun run scripts/pre-release.ts"
	},
	"workspaces": [
		"packages/*"
	],
	"catalogs": {
		"development": {
			"@eslint/js": "latest",
			"@types/bun": "latest",
			"eslint": "latest",
			"eslint-config-prettier": "latest",
			"eslint-plugin-import": "latest",
			"eslint-import-resolver-typescript": "latest",
			"typescript-eslint": "latest",
			"prettier": "latest",
			"typescript": "latest"
		},
		"elysia": {
			"elysia": "latest"
		},
		"react": {
			"@types/react": "latest",
			"@types/react-dom": "latest",
			"react": "latest",
			"react-dom": "latest"
		},
		"system": {
			"pino": "latest",
			"pino-pretty": "latest"
		},
		"validation": {
			"@sinclair/typebox": "latest"
		}
	},
	"devDependencies": {
		"@eslint/js": "catalog:development",
		"@types/bun": "catalog:development",
		"eslint": "catalog:development",
		"eslint-config-prettier": "catalog:development",
		"eslint-import-resolver-typescript": "catalog:development",
		"eslint-plugin-import": "catalog:development",
		"prettier": "catalog:development",
		"typescript": "catalog:development",
		"typescript-eslint": "catalog:development"
	}
}
