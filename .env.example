# Glaze environment — copy to `.env` and fill in.
# Glaze validates these at boot and fails fast with a per-variable message and a
# fix hint if anything is missing or malformed.

# ── Database ──────────────────────────────────────────────────────────────────
# Read by YOUR glaze.config.ts (e.g. `connection: process.env.DATABASE_URL`), not
# by the framework directly — so the variable name is your choice; DATABASE_URL is
# just the convention. Postgres connection string, or a SQLite file path / :memory:.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/glaze

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signing secret for sessions. REQUIRED in production; at least 32 characters.
# In development it may be left unset — Glaze uses an insecure dev fallback and warns.
# Generate one:  openssl rand -base64 48
GLAZE_AUTH_SECRET=

# Base URL for Better Auth (optional). Must start with http:// or https://.
# GLAZE_AUTH_URL=http://localhost:4000

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port (optional; default 4000). PORT is honored as a fallback.
# GLAZE_PORT=4000

# Environment: local | development | test | staging | production (optional; default development).
# NODE_ENV=development

# ── Convergence (schema-at-boot) ──────────────────────────────────────────────
# Force schema convergence to run non-interactively — decline rename / data-loss
# prompts and fail closed — when a terminal is allocated but no human is attached
# (e.g. `docker run -t` without `-i`, some process managers). CI=true is
# auto-detected and has the same effect, so most CI needs nothing here.
# GLAZE_NO_TTY=1
