{
	"name": "@glaze/admin",
	"version": "0.0.6",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && bun build src/index.ts --outdir dist --target bun",
		"lint": "eslint . && stylelint \"src/**/*.css\"",
		"lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"preview": "vite preview",
		"prepublishOnly": "bun run build"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@react-spring/web": "latest",
		"@tanstack/react-router": "latest",
		"better-auth": "catalog:auth",
		"classnames": "^2.5.1",
		"react": "catalog:react",
		"react-dom": "catalog:react"
	},
	"devDependencies": {
		"@babel/core": "latest",
		"@eslint/js": "catalog:development",
		"@rolldown/plugin-babel": "latest",
		"@tanstack/router-plugin": "latest",
		"@types/babel__core": "latest",
		"@types/node": "latest",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"@vitejs/plugin-react": "latest",
		"babel-plugin-react-compiler": "latest",
		"eslint": "catalog:development",
		"eslint-plugin-react-hooks": "latest",
		"eslint-plugin-react-refresh": "latest",
		"globals": "latest",
		"typescript": "catalog:development",
		"typescript-eslint": "catalog:development",
		"vite": "latest",
		"vite-plugin-svgr": "latest",
		"vite-tsconfig-paths": "latest"
	},
	"overrides": {
		"vite": "npm:rolldown-vite@latest"
	}
}
