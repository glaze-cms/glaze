{
	"name": "glaze-cms",
	"version": "0.0.0",
	"description": "The Bun-native headless CMS framework.",
	"license": "MIT",
	"files": [
		"dist",
		"admin-dist",
		"index.ts",
		"types/**/*.ts",
		"config/**/*.ts",
		"convergence/**/*.ts",
		"lib/**/*.ts",
		"server/**/*.ts",
		"runtime/**/*.ts",
		"dialect/**/*.ts",
		"logger/**/*.ts",
		"!**/*.test.ts",
		"!harness/**"
	],
	"type": "module",
	"main": "./index.ts",
	"types": "./dist/index.d.ts",
	"imports": {
		"#config": "./config/index.ts",
		"#consts": "./lib/consts/index.ts",
		"#convergence": "./convergence/index.ts",
		"#dialect": "./dialect/index.ts",
		"#harness": "./harness/index.ts",
		"#logger": "./logger/index.ts",
		"#runtime": "./runtime/index.ts",
		"#server": "./server/index.ts",
		"#types": "./lib/types/index.ts",
		"#utils": "./lib/utils/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./index.ts"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./types/index.ts"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./config/index.ts"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./server/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@elysia/node": "2.0.0-beta.1",
		"@elysia/openapi": "2.0.0-exp.1",
		"better-auth": "^1.6.24",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"elysia": "2.0.0-beta.2",
		"pino": "latest",
		"pino-pretty": "latest",
		"postgres": "latest",
		"typebox": "^1.3"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "latest"
	},
	"engines": {
		"node": ">=24"
	}
}
