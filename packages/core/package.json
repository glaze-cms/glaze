{
	"name": "@glaze/core",
	"version": "0.0.19",
	"description": "Core module of the Glaze framework, responsible for running the CMS server and providing essential functionality.",
	"license": "MIT",
	"type": "module",
	"main": "./index.ts",
	"module": "./index.ts",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"*.ts",
		"server",
		"!**/*.test.ts"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./index.ts"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./types.ts"
		}
	},
	"scripts": {
		"start": "bun run index.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "bunx tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@glaze/admin": "workspace:*",
		"@glaze/logger": "workspace:*",
		"elysia": "latest",
		"@elysiajs/cors": "latest",
		"@sinclair/typebox": "latest",
		"pino": "catalog:system"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
