{
	"name": "@glaze/core",
	"version": "0.0.2",
	"description": "Core framework for Glaze CMS - a Bun-native headless CMS",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"prepare": "tsc",
		"start": "bun run src/index.ts",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix",
		"format": "prettier --check src/**/*.ts",
		"format:fix": "prettier --write src/**/*.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "catalog:development"
	}
}
