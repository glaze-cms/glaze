{
	"name": "@glaze/logger",
	"version": "0.0.3",
	"description": "Pino-powered logger with Glaze defaults for production and development.",
	"type": "module",
	"sideEffects": false,
	"main": "index.ts",
	"types": "./dist/index.d.ts",
	"files": ["dist", "*.ts", "!*.test.ts"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./index.ts"
		}
	},
	"scripts": {
		"prepublishOnly": "bunx tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"pino": "latest",
		"pino-pretty": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
